{
  "entities": {
    "User": {
      "title": "User",
      "description": "User settings and profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "lastActiveProjectId": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Resource": {
      "title": "Resource",
      "description": "A resource in the library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Labor", "Material", "Equipment", "Subcontractor"] },
        "unit": { "type": "string" },
        "unitPrice": { "type": "number" },
        "category": { "type": "string" },
        "code": { "type": "string" },
        "productivityUnit": { "type": "string", "enum": ["unit/day", "unit/hour"] },
        "crewSize": { "type": "number" },
        "conversionFactor": { "type": "number" },
        "productivity": { "type": "number" },
        "purchaseUnit": { "type": "string" }
      },
      "required": ["id", "name", "type", "unit", "unitPrice"]
    },
    "Project": {
      "title": "Project",
      "description": "A project with BOQ items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "scopeOfWork": { "type": "string" },
        "boqItems": { "type": "array" },
        "subcontractorOffers": { "type": "array" },
        "qsTakeoffs": { "type": "array" },
        "currency": { "type": "string" },
        "country": { "type": "string" },
        "updatedAt": { "type": "string" },
        "resourceLibrary": { "type": "array" }
      },
      "required": ["id", "name", "currency", "country", "updatedAt"]
    },
    "ActivityTemplate": {
      "title": "Activity Template",
      "description": "A template for an activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "unit": { "type": "string" },
        "conversionRate": { "type": "number" },
        "productivity": { "type": "number" },
        "resources": { "type": "array" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile"
    },
    "users/{userId}/resourceLibrary/{resourceId}": {
      "schema": "Resource",
      "description": "User's resource library"
    },
    "users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User's projects"
    },
    "users/{userId}/activityTemplates/{templateId}": {
      "schema": "ActivityTemplate",
      "description": "User's activity templates"
    }
  }
}
